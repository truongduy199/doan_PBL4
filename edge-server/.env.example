# Edge Server Environment Config (MySQL/InnoDB Single Source of Truth)
APP_ENV=development
DEBUG=True
CONFIG_DIR=configs

# MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_parking_pbl4
MYSQL_POOL_SIZE=10
MYSQL_DEADLOCK_RETRIES=3

# Business & Timing Rules (UTC inside DB, Asia/Ho_Chi_Minh on UI)
BOOKING_TTL_MINUTES=60
SLOT_STALE_SECONDS=30
PARKING_CONFIRM_TIMEOUT_SECONDS=120
SESSION_TEMPLATE_RETENTION_HOURS=24
EXPIRY_WORKER_INTERVAL_SECONDS=5

# Serial / Hardware Gateway
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# Security & Encryption (Keys MUST stay outside database)
# 32-byte AES-256 key encoded in URL-safe base64 or 64-char hex
EMBEDDING_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
EMBEDDING_KEY_VERSION=v1
JWT_SECRET_KEY=pbl4_smart_parking_jwt_secret_key_2026_change_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# Demo Seed Accounts & Vehicle
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_USER_USERNAME=viet_user
DEMO_USER_PASSWORD=Viet@123
DEMO_USER_DISPLAY_NAME=Nguyễn Văn Việt (Chủ xe Demo)
DEMO_VEHICLE_PLATE=43A12345
