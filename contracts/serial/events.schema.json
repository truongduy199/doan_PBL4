{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SerialEventsSchema",
  "description": "Schema cho các sự kiện từ ESP32 gửi lên Edge Server",
  "type": "object",
  "required": ["version", "message_id", "type", "gate_transaction_id", "timestamp_ms", "payload"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "message_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "GATE_IN_TRIGGER",
        "GATE_OUT_TRIGGER",
        "PASSAGE_COMPLETED",
        "SENSOR_STATE",
        "COMMAND_ACK",
        "DEVICE_ERROR",
        "HEARTBEAT"
      ]
    },
    "gate_transaction_id": { "type": "string" },
    "timestamp_ms": { "type": "integer" },
    "payload": { "type": "object" },
    "checksum": { "type": "string" }
  }
}