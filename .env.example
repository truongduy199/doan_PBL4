# Global Environment Variables Example (Kiến trúc MySQL + FastAPI chốt 18/11/2026)
PROJECT_NAME="Smart Parking PBL4"
ENVIRONMENT="development"
DEBUG=true

# MySQL Database (Single Source of Truth)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_parking_pbl4

# Backend API & Frontend URLs
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
